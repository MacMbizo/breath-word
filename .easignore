# EAS Build upload exclusions.
# EAS compiles the app on its own Linux builders and runs `pnpm install`
# there, so no dependency or build-artifact directory should be uploaded.
# This mirrors .gitignore and additionally keeps the in-repo pnpm store out
# of the (multi-GB) cloud upload.
node_modules/
.pnpm-store/
dist/
build/
.turbo/
apps/desktop/src-tauri/target/
tools/pack-builder/out/
*.log

# Generated native project. When EAS sees an `android/` directory it skips
# `expo prebuild`, which silently bypasses every config plugin (and ignores
# `android.package` from app.json). Excluding it keeps the cloud build on the
# Continuous Native Generation path so config plugins apply.
apps/mobile/android/

# Secrets — never upload local env files to the build servers (E1 hard rule).
# Present in .easignore because EAS uses this file *instead of* .gitignore; without
# it, an .env.local holding EXPO_TOKEN would be part of the cloud upload.
.env
.env.*
*.local

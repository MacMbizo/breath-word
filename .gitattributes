# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never let git touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.keystore binary
*.jar binary
*.sqlite binary
*.sqlite3 binary
*.gz binary
*.so binary
*.dll binary
*.dylib binary
*.a binary
*.wasm binary

# Generated / vendored files (kept out of language stats).
pnpm-lock.yaml linguist-generated=true
apps/desktop/src-tauri/Cargo.lock linguist-generated=true
apps/mobile/android/gradlew linguist-vendored=true
apps/mobile/android/gradlew.bat linguist-vendored=true

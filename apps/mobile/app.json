{
  "expo": {
    "name": "Breath & Word",
    "slug": "breath-and-word",
    "owner": "trinarpil",
    "version": "0.1.0",
    "scheme": "breathandword",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-preview-cleartext"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.breathandword.mobile"
    },
    "android": {
      "package": "app.breathandword.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c0f06452-c147-4b26-9c1a-b8fe49a6b6af"
      }
    }
  }
}

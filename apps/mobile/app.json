{
  "expo": {
    "name": "Breath & Word",
    "slug": "breath-and-word",
    "version": "0.1.0",
    "scheme": "breathandword",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.breathandword.mobile"
    },
    "android": {
      "package": "app.breathandword.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

# Breath & Word — mobile environment template
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; NEVER commit real credentials.
#
# Only *client-safe* values belong here (E1 §4.2). Anything secret lives server-side
# in Edge Functions / CI — it must never carry an `EXPO_PUBLIC_` prefix.

# Public Supabase project URL (safe; protected by RLS).
EXPO_PUBLIC_SUPABASE_URL=

# Public anon key (safe; zero privilege without a user JWT + RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PowerSync Cloud endpoint.
EXPO_PUBLIC_POWERSYNC_URL=

# Content-pack manifest URL (Cloudflare R2).
EXPO_PUBLIC_PACK_MANIFEST_URL=

# Optional, opt-in, privacy-scrubbed crash reporting DSN.
EXPO_PUBLIC_SENTRY_DSN=
